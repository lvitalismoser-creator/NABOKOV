@startuml DER_Oscorp
title Oscorp - Diagrama Entidade-Relacionamento (MySQL oscorp_platform)
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName SansSerif

entity "contas" as contas {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * tipo : VARCHAR <<discriminador: DIRETOR | COLABORADOR>>
  * nome : VARCHAR(100)
  * email : VARCHAR(150)
  * login : VARCHAR(50) <<UNIQUE>>
  * senha : VARCHAR(255)
  * ativo : BOOLEAN
}

entity "permissoes" as permissoes {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * nome : VARCHAR(50) <<UNIQUE>>
  descricao : VARCHAR(200)
}

entity "conta_permissoes" as cp {
  * conta_id : BIGINT <<PK, FK>>
  * permissao_id : BIGINT <<PK, FK>>
}

entity "auditorias_acesso" as aud {
  * id : BIGINT <<PK, AUTO_INCREMENT>>
  --
  * conta_id : BIGINT <<FK>>
  * data_hora : DATETIME
  * sucesso : BOOLEAN
}

contas ||--o{ cp : "possui"
permissoes ||--o{ cp : "concedida em"
contas ||--o{ aud : "registra tentativas"

note bottom of contas
  Herança SINGLE_TABLE:
  Individuo (@MappedSuperclass) -> Conta -> Diretor / Colaborador
  todas na tabela "contas"
end note
@enduml
